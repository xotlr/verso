{
  "name": "screenwriter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "bun run build:wasm:release && prisma generate && next build",
    "build:wasm": "cd verso-engine && wasm-pack build --target web --out-dir ../public/wasm",
    "build:wasm:release": "command -v wasm-pack >/dev/null 2>&1 && cd verso-engine && wasm-pack build --target web --release --out-dir ../public/wasm || echo 'wasm-pack not found, using pre-built WASM'",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
