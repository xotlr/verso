{
  "name": "screenwriter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run build:wasm:release && node scripts/generate-integrity.js && DISABLE_PWA=true next build --webpack && node scripts/post-build.js",
    "build:dev": "bun run build:wasm:release && next build",
    "analyze": "ANALYZE=true npm run build",
    "build:wasm": "cd verso-engine && wasm-pack build --target web --out-dir ../public/wasm",
    "build:wasm:release": "bash scripts/build-wasm-hardened.sh || (command -v wasm-pack >/dev/null 2>&1 && cd verso-engine && wasm-pack build --target web --release --out-dir ../public/wasm || echo 'wasm-pack not found, using pre-built WASM')",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "echo 'skipping husky'",
    "postinstall": "cp node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs 2>/dev/null || true",
    "sbom": "node scripts/generate-sbom.js"
  },
