generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth Models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // For credentials auth (hashed with bcrypt)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Username (for clean profile URLs like /u/johndoe)
  username String? @unique

  // Profile
  banner   String? // Banner image URL
  bio      String? @db.Text
  title    String? // "Screenwriter", "Director", etc.
  location String?
  website  String?

  // Social links
  twitter  String?
  linkedin String?
  imdb     String?

  // Core Profile (NEW - glanceable)
  oneLiner     String?      @db.VarChar(100) // "Screenwriter. Horror. Vienna." - replaces bio
  roles        String[]     @default([]) // Multi-select: writer, director, cinematographer, etc.
  reelUrl      String? // Primary portfolio link (Vimeo, YouTube, website)
  availability Availability @default(NOT_LOOKING) // Green/yellow/red status

  // The Work
  featuredProjectId String? // Pinned project FK
  showcaseTimelapse String? // Timelapse shareId for replay showcase

  // Trust Layer
  responseRate      ResponseRate @default(UNKNOWN)
  projectsCompleted Int          @default(0)

  // The Vibe
  influences String[] @default([]) // Max 3 directors/writers/films
  gear       String?  @db.Text // Equipment for crew: "RED Komodo, Ronin 4D"
  languages  String[] @default([]) // Languages spoken

  // LEGACY - keeping for migration, will be removed
  interests  String[] @default([]) // -> migrated to influences
  skills     String[] @default([]) // -> migrated to roles
  lookingFor String?  @db.Text // "Looking for a DOP in LA" (keep this one)

  // Profile visibility
  isPublic Boolean @default(true)

  // User preferences
  shortcuts Json? // Custom keyboard shortcuts

  // Subscription
  plan                   Plan      @default(FREE)
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  // Relations
  accounts           Account[]
  sessions           Session[]
  projects           Project[]
  screenplays        Screenplay[]
  screenplayVersions ScreenplayVersion[] @relation("ScreenplayVersionCreator")
  notes              Note[]
  schedules          Schedule[]
  budgets            Budget[]
  callsheets         Callsheet[]
  teamMembers        TeamMember[]
  ownedTeams         Team[]              @relation("TeamOwner")
  stats              UserStats?
  writingSessions    WritingSession[]
  externalLinks      ExternalLink[]
  invitesSent        TeamInvite[]        @relation("InvitesSent")
  activities         Activity[]
  teamAuditLogs      TeamAuditLog[]      @relation("AuditLogActor")

  // Collaboration relations
  screenplayOperations  ScreenplayOperation[]   @relation("ScreenplayOperations")
  collaborationSessions CollaborationSession[]  @relation("CollaborationSessions")
  resolvedConflicts     CollaborationConflict[] @relation("ConflictResolver")

  // Project roles (when user is assigned as director, writer, etc.)
  projectRoles ProjectRole[]

  // Project role invites sent by this user
  projectRoleInvitesSent ProjectRoleInvite[] @relation("ProjectRoleInvitesSent")

  // Role applications (interest in open project roles)
  roleApplications ProjectRoleApplication[]

  // Professional connections
  connectionsSent     Connection[] @relation("ConnectionRequester")
  connectionsReceived Connection[] @relation("ConnectionAddressee")

  // Greeting history (for smart greeting algorithm)
  greetingHistory GreetingHistory[]

  // Series owned by this user
  series Series[]

  // Stacks owned by this user (lightweight screenplay groups)
  stacks Stack[]

  // Profile credits (work history)
  credits Credit[]

  // Featured project relation
  featuredProject Project? @relation("FeaturedProject", fields: [featuredProjectId], references: [id], onDelete: SetNull)

  // User-level sharing relations
  screenplaySharesReceived ScreenplayShare[] @relation("ScreenplaySharesReceived")
  screenplaySharesGiven    ScreenplayShare[] @relation("ScreenplaySharesGiven")
  projectSharesReceived    ProjectShare[]    @relation("ProjectSharesReceived")
  projectSharesGiven       ProjectShare[]    @relation("ProjectSharesGiven")
  seriesSharesReceived     SeriesShare[]     @relation("SeriesSharesReceived")
  seriesSharesGiven        SeriesShare[]     @relation("SeriesSharesGiven")
  shareInvitesSent         ShareInvite[]     @relation("ShareInvitesSent")

  // Production notifications
  notifications Notification[]

  // Digital sides and callsheet shares created by this user
  digitalSidesCreated        DigitalSide[]        @relation("DigitalSidesCreated")
  callsheetShareLinksCreated CallsheetShareLink[] @relation("CallsheetShareLinksCreated")

  @@index([plan]) // Used in limit checks
  @@index([username])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Profile
  banner      String?
  logo        String? // Team logo
  description String? @db.Text
  website     String?
  isPublic    Boolean @default(true)

  // Billing / Seats
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  maxSeats               Int       @default(3) // Based on plan (PRO=3, TEAM=10)

  owner       User           @relation("TeamOwner", fields: [ownerId], references: [id])
  members     TeamMember[]
  invites     TeamInvite[]
  projects    Project[]
  screenplays Screenplay[]
  auditLogs   TeamAuditLog[]
}

model TeamInvite {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  role      TeamRole @default(MEMBER)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
  invitedBy String

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter User @relation("InvitesSent", fields: [invitedBy], references: [id])

  @@unique([teamId, email])
  @@index([token])
  @@index([email])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole @default(MEMBER)
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId]) // For "all teams user belongs to" queries
}

// Project status enum
enum ProjectStatus {
  DEVELOPMENT
  PRE_PRODUCTION
  PRODUCTION
  POST_PRODUCTION
  COMPLETED
}

// Project type enum
enum ProjectType {
  FEATURE_FILM
  SHORT_FILM
  TV_SERIES
  STAGE_PLAY
  OTHER
}

// Project = Production workspace container (like Supabase projects)
model Project {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  coverImage  String?
  banner      String?       // Banner image URL
  logo        String?       // Project logo/icon URL
  type        ProjectType   @default(FEATURE_FILM)
  status      ProjectStatus @default(DEVELOPMENT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Production info
  budget Float? // Total project budget

  // Publishing/Discovery
  isPublic    Boolean   @default(false)
  publishedAt DateTime?

  // Ownership
  userId String
  teamId String?

  // Relations
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  team          Team?               @relation(fields: [teamId], references: [id])
  screenplays   Screenplay[]
  notes         Note[]
  schedules     Schedule[]
  budgets       Budget[]
  callsheets    Callsheet[]
  externalLinks ExternalLink[]
  roles         ProjectRole[]
  roleInvites   ProjectRoleInvite[]
  roleNeeds     ProjectRoleNeed[]

  // Series that belong to this project
  series Series[]

  // Stacks that belong to this project
  stacks Stack[]

  // Users who have this as their featured project
  featuredByUsers User[] @relation("FeaturedProject")

  // Credits referencing this project
  projectCredits Credit[] @relation("CreditProject")

  // User-level sharing (Google Drive-like)
  shares       ProjectShare[]
  shareInvites ShareInvite[]

  @@index([userId])
  @@index([teamId])
  @@index([isPublic, publishedAt])
}

// Stack = Lightweight grouping of screenplays (simpler than Series, like Procreate stacks)
model Stack {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ownership
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional: Stack can belong to a Project (one level nesting max)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Screenplays in this stack
  screenplays Screenplay[] @relation("StackScreenplays")

  @@index([userId])
  @@index([projectId])
}

// Series = TV Series container (holds seasons and episodes)
model Series {
  id        String   @id @default(cuid())
  title     String
  logline   String?  @db.Text
  genre     String?
  format    String? // "one-hour", "half-hour", "multi-cam"
  banner    String? // Banner image URL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ownership
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional: Series can belong to a Project
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  // Seasons (each season contains episodes)
  seasons Season[]

  // Legacy: Direct episodes relation (kept for migration, will be removed)
  episodes Screenplay[] @relation("SeriesEpisodes")

  // User-level sharing (Google Drive-like)
  shares       SeriesShare[]
  shareInvites ShareInvite[]

  @@index([userId])
  @@index([projectId])
}

// Season = Container for episodes within a series
model Season {
  id          String   @id @default(cuid())
  number      Int // Season number (1, 2, 3...)
  title       String? // Optional title (e.g., "The Beginning")
  description String?  @db.Text
  status      String   @default("planning") // "planning", "writing", "complete"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seriesId String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  // Episodes in this season
  episodes Screenplay[] @relation("SeasonEpisodes")

  @@unique([seriesId, number]) // Can't have duplicate season numbers within a series
  @@index([seriesId])
}

// Project roles (Director, Writer, Producer, etc.)
model ProjectRole {
  id        String   @id @default(cuid())
  projectId String
  role      String // "director" | "writer" | "producer" | "cinematographer" | "editor" | "composer" | etc.
  name      String // Person's name
  userId    String? // Optional link to a Verso user
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([projectId, role, name]) // Prevent duplicate role assignments
  @@index([projectId])
  @@index([userId])
}

// Project role invites (pending invitations to join a project in a specific role)
model ProjectRoleInvite {
  id        String   @id @default(cuid())
  projectId String
  email     String
  role      String // "director" | "writer" | "producer" | etc.
  token     String   @unique @default(cuid())
  expiresAt DateTime
  invitedBy String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  inviter User    @relation("ProjectRoleInvitesSent", fields: [invitedBy], references: [id])

  @@unique([projectId, email, role]) // One invite per email+role per project
  @@index([token])
  @@index([email])
  @@index([projectId])
}

// Project role needs (open positions/roles the project is looking for)
model ProjectRoleNeed {
  id          String   @id @default(cuid())
  projectId   String
  role        String // "director" | "writer" | "producer" | "cinematographer" | etc.
  description String?  @db.Text
  location    String? // "Los Angeles", "Remote", etc.
  isPaid      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applications ProjectRoleApplication[]

  @@index([projectId])
}

// Applications/Interest for open project roles
model ProjectRoleApplication {
  id         String            @id @default(cuid())
  roleNeedId String
  userId     String
  message    String?           @db.Text
  status     ApplicationStatus @default(PENDING)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  roleNeed ProjectRoleNeed @relation(fields: [roleNeedId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roleNeedId, userId]) // One application per user per role need
  @@index([roleNeedId])
  @@index([userId])
  @@index([status])
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
}

// Screenplay = Actual screenplay document (can be standalone or in a project)
model Screenplay {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  synopsis  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Can be standalone (userId only) OR in a project OR in a series
  userId    String
  projectId String?
  teamId    String?

  // TV Series relations
  seriesId String? // Legacy: Direct link to Series (kept for migration)
  seasonId String? // New: Link to Season (episodes belong to seasons)

  // Stack relation (lightweight grouping)
  stackId String?
  stack   Stack?  @relation("StackScreenplays", fields: [stackId], references: [id], onDelete: SetNull)

  // Screenplay type
  type         ScreenplayType @default(FILM)
  format       String         @default("feature-film") // 'feature-film' | 'tv-one-hour' | 'tv-half-hour' | 'tv-multi-cam'
  season       Int? // Legacy: Season number (kept for migration, use seasonId instead)
  episode      Int? // Episode number within the season
  episodeTitle String? // Episode title

  // Title page metadata
  contactName          String? // Contact name for title page
  contactEmail         String? // Contact email
  contactPhone         String? // Contact phone number
  contactAddress       String? @db.Text // Contact address (multi-line)
  copyrightYear        Int? // Copyright year
  copyrightHolder      String? // Copyright holder name
  registrationNumber   String? // WGA/copyright registration number
  draftLabel           String? // "First Draft", "Shooting Draft", etc.
  draftDate            DateTime? // Draft date
  showTitlePageContact Boolean  @default(true) // Whether to show contact on title page
  showTitlePageCopyright Boolean @default(true) // Whether to show copyright on title page
  showTitlePageDraft   Boolean  @default(true) // Whether to show draft info on title page

  // Quick Access fields
  isFavorite   Boolean   @default(false)
  lastOpenedAt DateTime?

  // Publishing fields
  isPublic    Boolean   @default(false)
  publishedAt DateTime?
  views       Int       @default(0)
  genre       String?
  logline     String?   @db.Text
  author      String?

  // Cached stats (computed on save for performance)
  wordCount Int @default(0)

  // Beat board acts configuration
  acts Json? // Custom acts: [{ id: string, label: string }]

  // Timelapse recording
  timelapseEnabled Boolean   @default(true) // Whether to record operations for timelapse
  timelapseStarted DateTime? // When timelapse recording started
  timelapseShareId String?   @unique // Public share ID for timelapse (cuid)

  // Relations
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  project          Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team             Team?               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  series           Series?             @relation("SeriesEpisodes", fields: [seriesId], references: [id], onDelete: SetNull)
  seasonRef        Season?             @relation("SeasonEpisodes", fields: [seasonId], references: [id], onDelete: SetNull)
  versions         ScreenplayVersion[]
  sceneMetas       SceneMeta[]
  characterMetas   CharacterMeta[]
  sceneAttachments SceneAttachment[]
  shots            Shot[]

  // Collaboration relations
  operations            ScreenplayOperation[]
  collaborationSessions CollaborationSession[]
  conflicts             CollaborationConflict[]

  // Share link relation
  shareLink ShareLink?

  // User-level sharing (Google Drive-like)
  shares       ScreenplayShare[]
  shareInvites ShareInvite[]

  // Digital sides for production
  digitalSides DigitalSide[]

  @@index([userId])
  @@index([projectId])
  @@index([teamId])
  @@index([seriesId])
  @@index([seasonId])
  @@index([stackId])
  @@index([isPublic, publishedAt])
  @@index([userId, lastOpenedAt])
  @@index([timelapseShareId])
}

// Share permissions for link-based access
enum SharePermission {
  VIEW // Read-only access
  COMMENT // Can view and add comments
  EDIT // Full editing access
}

// Link-based sharing for screenplays
model ShareLink {
  id           String          @id @default(cuid())
  screenplayId String          @unique
  token        String          @unique @default(cuid())
  permission   SharePermission @default(VIEW)
  isActive     Boolean         @default(true)
  expiresAt    DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  screenplay     Screenplay      @relation(fields: [screenplayId], references: [id], onDelete: Cascade)
  accessRequests AccessRequest[]

  @@index([token])
  @@index([screenplayId])
}

// Access request status for share links
enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

// Access requests for shared screenplays
model AccessRequest {
  id            String              @id @default(cuid())
  shareLinkId   String
  email         String
  name          String?
  message       String?             @db.Text
  requestedRole SharePermission     @default(VIEW)
  status        AccessRequestStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  respondedAt   DateTime?

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)

  @@unique([shareLinkId, email])
  @@index([shareLinkId])
  @@index([email])
}

// User-level sharing permission roles
enum ShareRole {
  VIEWER    // Can view only
  COMMENTER // Can view and comment
  EDITOR    // Can edit content
  ADMIN     // Can edit and manage sharing
}

// User-level screenplay sharing (Google Drive-like)
model ScreenplayShare {
  id           String    @id @default(cuid())
  screenplayId String
  userId       String
  role         ShareRole @default(VIEWER)
  sharedBy     String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  screenplay Screenplay @relation(fields: [screenplayId], references: [id], onDelete: Cascade)
  user       User       @relation("ScreenplaySharesReceived", fields: [userId], references: [id], onDelete: Cascade)
  sharer     User       @relation("ScreenplaySharesGiven", fields: [sharedBy], references: [id], onDelete: Cascade)

  @@unique([screenplayId, userId])
  @@index([userId])
  @@index([screenplayId])
}

// User-level project sharing
model ProjectShare {
  id        String    @id @default(cuid())
  projectId String
  userId    String
  role      ShareRole @default(VIEWER)
  sharedBy  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectSharesReceived", fields: [userId], references: [id], onDelete: Cascade)
  sharer  User    @relation("ProjectSharesGiven", fields: [sharedBy], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
}

// User-level series sharing
model SeriesShare {
  id        String    @id @default(cuid())
  seriesId  String
  userId    String
  role      ShareRole @default(VIEWER)
  sharedBy  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  series Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  user   User   @relation("SeriesSharesReceived", fields: [userId], references: [id], onDelete: Cascade)
  sharer User   @relation("SeriesSharesGiven", fields: [sharedBy], references: [id], onDelete: Cascade)

  @@unique([seriesId, userId])
  @@index([userId])
  @@index([seriesId])
}

// Pending share invites (for email-based invites to non-users)
model ShareInvite {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique @default(cuid())
  role      ShareRole @default(VIEWER)

  // Polymorphic: one of these will be set
  screenplayId String?
  projectId    String?
  seriesId     String?

  invitedBy String
  expiresAt DateTime
  createdAt DateTime @default(now())

  screenplay Screenplay? @relation(fields: [screenplayId], references: [id], onDelete: Cascade)
  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  series     Series?     @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  inviter    User        @relation("ShareInvitesSent", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
}

// Version history for screenplays
model ScreenplayVersion {
  id           String @id @default(cuid())
  screenplayId String

  // Content
  content String @db.Text

  // Metadata
  versionNumber Int
  label         String? // User-named snapshots
  reason        String // "manual" | "auto" | "interval" | "restore"
  revisionColor String? // Industry-standard revision color: white, blue, pink, yellow, green, goldenrod, buff, salmon
  message       String? @db.Text // Commit message/notes describing what changed

  // Stats
  wordCount   Int
  sceneCount  Int
  changeStats Json? // { wordsAdded, wordsRemoved, scenesAdded, scenesRemoved }

  // Tracking
  createdAt DateTime @default(now())
  createdBy String

  // Relations
  screenplay Screenplay @relation(fields: [screenplayId], references: [id], onDelete: Cascade)
  creator    User       @relation("ScreenplayVersionCreator", fields: [createdBy], references: [id])

  @@index([screenplayId, createdAt])
  @@index([screenplayId, versionNumber])
}

// Scene metadata (colors, notes per scene)
model SceneMeta {
  id           String @id @default(cuid())
  screenplayId String
  sceneId      String // References scene ID in screenplay content

  // Metadata
  color String? // Hex color for scene (e.g., "#FF5733")
  notes String? @db.Text
  mood  String? // e.g., "tense", "romantic", "action"
  act   String? // Act assignment: 'act1' | 'act2a' | 'act2b' | 'act3' | null (unassigned)

  // Tracking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  screenplay Screenplay @relation(fields: [screenplayId], references: [id], onDelete: Cascade)

  @@unique([screenplayId, sceneId])
  @@index([screenplayId])
}

// Character metadata (roles, notes per character)
model CharacterMeta {
  id            String @id @default(cuid())
  screenplayId  String
  characterName String // Character name (extracted from dialogue)

  // Metadata
  role        String  @default("Supporting") // Protagonist, Antagonist, Supporting, Minor
  description String? @db.Text
  notes       String? @db.Text

  // Tracking
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  screenplay Screenplay @relation(fields: [screenplayId], references: [id], onDelete: Cascade)

  @@unique([screenplayId, characterName])
  @@index([screenplayId])
}

// Scene attachments (images, references, mood board)
model SceneAttachment {
  id           String @id @default(cuid())
  screenplayId String
  sceneId      String // References scene ID in screenplay content

  // Attachment data
  type         String // "image" | "reference" | "moodboard"
  url          String // Supabase Storage URL
  filename     String? // Original filename
  caption      String?
  displayOrder Int     @default(0)

  // Tracking
  createdAt DateTime @default(now())

  // Relations
  screenplay Screenplay @relation(fields: [screenplayId], references: [id], onDelete: Cascade)

  @@index([screenplayId, sceneId])
  @@index([screenplayId])
}

// Shot = Production shotlist for filming
model Shot {
  id           String @id @default(cuid())
  screenplayId String
  sceneId      String // Links to scene (e.g., "scene-1")

  // Core info
  shotNumber  Int // Order within scene (1, 2, 3...)
  description String @db.Text

  // Shot type & framing
  shotType    String? // WIDE, MEDIUM, CLOSE_UP, etc.
  cameraAngle String? // EYE_LEVEL, HIGH_ANGLE, LOW_ANGLE, etc.

  // Camera movement
  movement String? // STATIC, PAN, TILT, DOLLY, CRANE, HANDHELD, etc.

  // Technical details
  duration Int? // Estimated duration in seconds
  lens     String? // 24mm, 50mm, 85mm, etc.

  // Production notes
  equipment String? @db.Text // Camera, rig, special equipment
  lighting  String? @db.Text // Lighting setup notes
  audio     String? @db.Text // Audio/sound notes
  notes     String? @db.Text // General notes

  // Storyboard
  thumbnailUrl  String? // Image URL for storyboard frame
  thumbnailType String? // "upload" | "url" - indicates image source

  // Status
  status String @default("planned") // planned, setup, shot, approved

  // Production tracking (on-set)
  takeCount       Int       @default(0)  // Number of takes
  circledTake     Int?                   // Selected/circled take
  quickNotes      String?   @db.Text     // Quick on-set notes
  statusChangedAt DateTime?              // When status last changed
  statusChangedBy String?                // User who changed status

  // Script Supervisor tracking
  supervisorNotes String?   @db.Text     // Detailed take notes
  lineReading     String?                // How dialogue was delivered
  continuityNotes String?   @db.Text     // Wardrobe, props, positioning
  isFlagged       Boolean   @default(false)  // Continuity concern flag

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  screenplay Screenplay @relation(fields: [screenplayId], references: [id], onDelete: Cascade)
  takeNotes  TakeNote[]

  @@index([screenplayId])
  @@index([screenplayId, sceneId])
}

// Per-take notes from Script Supervisor
model TakeNote {
  id        String   @id @default(cuid())
  shotId    String
  takeNum   Int
  rating    String?  // good | bad | circle | print
  notes     String?  @db.Text
  timecode  String?  // TC in/out
  createdAt DateTime @default(now())
  createdBy String

  shot      Shot     @relation(fields: [shotId], references: [id], onDelete: Cascade)

  @@unique([shotId, takeNum])
  @@index([shotId])
}

// Note = Project notes (research, character, location, etc.)
model Note {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  projectId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Schedule = Production schedule
model Schedule {
  id        String    @id @default(cuid())
  title     String
  startDate DateTime?
  endDate   DateTime?
  data      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  userId    String
  projectId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Budget = Production budget
model Budget {
  id        String   @id @default(cuid())
  title     String
  total     Float    @default(0)
  data      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  projectId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Callsheet status for production tracking
enum CallsheetStatus {
  DRAFT
  PUBLISHED
  COMPLETED
}

// Callsheet = Production call sheet for shoot days
model Callsheet {
  id              String          @id @default(cuid())
  title           String
  shootDate       DateTime
  callTime        DateTime
  wrapTime        DateTime?
  status          CallsheetStatus @default(DRAFT)
  primaryLocation String?
  data            Json?           // Full CallsheetData structure (scenes, cast, crew, etc.)
  weatherForecast String?
  weatherTemp     Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  userId    String
  projectId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Production tracking
  checkIns   CrewCheckIn[]
  shareLinks CallsheetShareLink[]

  @@index([projectId])
  @@index([shootDate])
}

enum Plan {
  FREE
  PLUS
  PRO
  MAX
}

enum Availability {
  AVAILABLE // Green - open for work
  BUSY // Yellow - limited availability
  NOT_LOOKING // Red - not seeking work
}

enum ResponseRate {
  UNKNOWN
  WITHIN_HOURS // "Usually responds within hours"
  WITHIN_DAY // "Usually responds within 24 hours"
  WITHIN_WEEK // "Usually responds within a week"
  SLOW // "May take a while to respond"
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum ScreenplayType {
  FILM
  TV
}

// User writing statistics
model UserStats {
  id            String    @id @default(cuid())
  userId        String    @unique
  dailyGoal     Int       @default(500)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastWriteDate DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Writing session tracking
model WritingSession {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @default(now())
  wordCount Int      @default(0)
  duration  Int      @default(0) // minutes

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// External links (Google Docs, research URLs, etc.)
model ExternalLink {
  id          String  @id @default(cuid())
  url         String
  title       String?
  description String? @db.Text
  favicon     String?
  image       String? // Open Graph image
  siteName    String?
  category    String? // "research" | "reference" | "script" | "other"

  // Enhanced embed support
  embedType    String? // "youtube" | "pinterest" | "shotdeck" | "google-docs" | "google-sheets" | "google-slides" | "canva" | "vimeo" | "generic"
  embedId      String? // Platform-specific ID (e.g., YouTube video ID)
  embedUrl     String? // Pre-computed embed URL for iframes
  thumbnailUrl String? // High-quality thumbnail URL
  isPlayable   Boolean @default(false) // Can play inline (videos)
  notes        String? @db.Text // Rich text notes about this resource

  userId    String
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([embedType])
}

// Activity feed for dashboard
model Activity {
  id          String   @id @default(cuid())
  userId      String
  type        String // "screenplay_created" | "screenplay_edited" | "project_created" | "screenplay_published"
  entityId    String? // ID of screenplay/project
  entityTitle String? // Cached title for display
  metadata    Json? // Extra context (word count delta, etc.)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Team audit log for compliance
model TeamAuditLog {
  id         String   @id @default(cuid())
  teamId     String
  actorId    String // User who performed action
  action     String // "team_created", "member_added", "settings_updated", etc.
  targetType String? // "member", "invite", "settings", "billing"
  targetId   String? // ID of affected resource
  metadata   Json? // Before/after values, extra context
  ipAddress  String?
  createdAt  DateTime @default(now())

  team  Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor User @relation("AuditLogActor", fields: [actorId], references: [id])

  @@index([teamId, createdAt])
  @@index([actorId])
}

// Real-time collaboration models
model ScreenplayOperation {
  id             String   @id @default(uuid())
  screenplayId   String   @map("screenplay_id")
  userId         String   @map("user_id")
  operationType  String   @map("operation_type") // 'insert', 'delete', 'replace', 'cursor_move'
  position       Int?
  content        String?  @db.Text
  metadata       Json?
  timestamp      DateTime @default(now())
  sequenceNumber BigInt   @default(autoincrement()) @map("sequence_number")

  screenplay Screenplay @relation(fields: [screenplayId], references: [id], onDelete: Cascade)
  user       User       @relation("ScreenplayOperations", fields: [userId], references: [id], onDelete: Cascade)

  @@index([screenplayId, timestamp(sort: Desc)])
  @@index([screenplayId, sequenceNumber(sort: Desc)])
  @@map("screenplay_operations")
}

model CollaborationSession {
  id             String   @id @default(uuid())
  screenplayId   String   @map("screenplay_id")
  userId         String   @map("user_id")
  editorType     String   @map("editor_type") // 'prosemirror' or 'classic'
  cursorPosition Int      @default(0) @map("cursor_position")
  lastSeen       DateTime @default(now()) @map("last_seen")
  metadata       Json?

  screenplay Screenplay @relation(fields: [screenplayId], references: [id], onDelete: Cascade)
  user       User       @relation("CollaborationSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([screenplayId, userId])
  @@index([screenplayId, lastSeen(sort: Desc)])
  @@map("collaboration_sessions")
}

model CollaborationConflict {
  id                     String    @id @default(uuid())
  screenplayId           String    @map("screenplay_id")
  operationId            String?   @map("operation_id")
  conflictingOperationId String?   @map("conflicting_operation_id")
  resolved               Boolean   @default(false)
  resolutionStrategy     String?   @map("resolution_strategy") // 'manual', 'auto_merge', 'last_write_wins'
  resolvedBy             String?   @map("resolved_by")
  resolvedAt             DateTime? @map("resolved_at")
  createdAt              DateTime  @default(now()) @map("created_at")

  screenplay Screenplay @relation(fields: [screenplayId], references: [id], onDelete: Cascade)
  resolver   User?      @relation("ConflictResolver", fields: [resolvedBy], references: [id])

  @@index([screenplayId, resolved, createdAt(sort: Desc)])
  @@map("collaboration_conflicts")
}

// Professional connections (LinkedIn-style mutual connections)
model Connection {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Profile credits (work history for filmmaker profiles)
model Credit {
  id           String   @id @default(cuid())
  userId       String
  title        String // Project/film title
  role         String // "Director", "Writer", etc.
  year         Int
  projectId    String? // Optional link to Verso project (auto-populated)
  isManual     Boolean  @default(true) // Manual entry vs auto-populated from Verso
  displayOrder Int      @default(0) // For custom ordering
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation("CreditProject", fields: [projectId], references: [id], onDelete: SetNull)

  @@unique([userId, title, role, year]) // Prevent duplicates
  @@index([userId])
  @@index([projectId])
}

// Processed webhook events for idempotency
model ProcessedWebhookEvent {
  id          String   @id // Stripe event ID
  eventType   String   @map("event_type")
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("processed_webhook_events")
}

// Greeting history for smart greeting algorithm (avoids repetition)
model GreetingHistory {
  id       String   @id @default(cuid())
  userId   String
  category String // GreetingCategory enum value (e.g., "LEGENDARY", "ON_FIRE")
  text     String // The actual greeting shown
  shownAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, shownAt])
  @@index([userId, category])
}

// ============================================
// Status Page Models
// ============================================

// Service health snapshots (recorded every 5 minutes by cron)
model ServiceHealthCheck {
  id           String   @id @default(cuid())
  service      String // "api", "database", "auth", "wasm"
  status       String   @default("operational") // "operational", "degraded", "outage"
  responseTime Int? // Response time in milliseconds
  errorMessage String?  @db.Text
  checkedAt    DateTime @default(now())

  @@index([service, checkedAt(sort: Desc)])
  @@index([checkedAt(sort: Desc)])
}

// Daily uptime aggregations (for 90-day history)
model UptimeRecord {
  id              String   @id @default(cuid())
  service         String // "api", "database", "auth", "wasm"
  date            DateTime // Normalized to midnight UTC
  uptimePercent   Float // 0-100
  downtimeMinutes Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([service, date])
  @@index([service, date(sort: Desc)])
}

// Incidents/Outages for public communication
model Incident {
  id               String           @id @default(cuid())
  title            String
  description      String           @db.Text
  status           String           @default("investigating") // "investigating", "identified", "monitoring", "resolved"
  severity         String           @default("minor") // "critical", "major", "minor"
  affectedServices String[]         @default([])
  startedAt        DateTime
  resolvedAt       DateTime?
  updates          IncidentUpdate[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
}

// Incident timeline updates
model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  message    String   @db.Text
  status     String // Status at time of update
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

// ============================================
// Production Tracking Models
// ============================================

// Crew check-in tracking for callsheets
model CrewCheckIn {
  id          String   @id @default(cuid())
  callsheetId String
  crewName    String   // Name from callsheet crew list
  department  String
  checkedInAt DateTime @default(now())
  checkedInBy String?  // Who marked them in (self or AD)
  notes       String?

  callsheet   Callsheet @relation(fields: [callsheetId], references: [id], onDelete: Cascade)

  @@unique([callsheetId, crewName])
  @@index([callsheetId])
}

// Real-time notifications (Supabase Realtime)
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // schedule_change | callsheet_update | checkin | wrap
  title     String
  body      String?
  data      Json?    // Related IDs, links
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

// Digital sides - filtered screenplay pages for cast/crew
model DigitalSide {
  id           String    @id @default(cuid())
  screenplayId String
  callsheetId  String?
  token        String    @unique @default(cuid())
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  filterType   String    @default("all") // all | character | scenes
  filterValue  String?   // Character name or scene IDs (comma-separated)
  title        String?   // Custom title for the sides
  userId       String
  createdAt    DateTime  @default(now())

  screenplay Screenplay @relation(fields: [screenplayId], references: [id], onDelete: Cascade)
  user       User       @relation("DigitalSidesCreated", fields: [userId], references: [id])

  @@index([token])
  @@index([screenplayId])
}

// Shareable callsheet links for mobile viewing
model CallsheetShareLink {
  id          String    @id @default(cuid())
  callsheetId String
  token       String    @unique @default(cuid())
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  filterType  String    @default("all") // all | department | person
  filterValue String?   // Department name or person name
  userId      String
  createdAt   DateTime  @default(now())

  callsheet Callsheet @relation(fields: [callsheetId], references: [id], onDelete: Cascade)
  user      User      @relation("CallsheetShareLinksCreated", fields: [userId], references: [id])

  @@index([token])
  @@index([callsheetId])
}
